# LeafIQ — Environment Variables
# Copy to .env and fill in values. Never commit .env to Git.
#
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"

# REQUIRED in production
LEAFIQ_SECRET_KEY=change-me-generate-a-real-key

# Environment: "development" | "production"
LEAFIQ_ENV=development

# Database URI (default: SQLite in webapp/)
# LEAFIQ_DB_URI=sqlite:////absolute/path/to/leafiq.db

# Upload folder (default: webapp/app/static/uploads/)
# LEAFIQ_UPLOAD_FOLDER=/absolute/path/to/uploads

# Max upload size in MB (default: 16)
LEAFIQ_MAX_UPLOAD_MB=16

# Model paths (defaults: models/ in project root)
# LEAFIQ_CNN_CHECKPOINT=/absolute/path/to/custom_cnn_best.keras
# LEAFIQ_XGB_PKL=/absolute/path/to/xgboost_best.pkl
